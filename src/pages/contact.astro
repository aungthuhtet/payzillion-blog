---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us" 
  description="Get in touch with Aung Thu Htet regarding payment systems, engineering inquiries, or partnerships."
>
  {/* hCaptcha API Script */}
  <script src="https://js.hcaptcha.com/1/api.js" async defer></script>

  <div class="max-w-2xl mx-auto space-y-10 py-6">
    
    <header class="space-y-3 border-b border-slate-200/80 pb-6">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
        Get in Touch
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        Have a question about payment infrastructure, consulting, or my book? Feel free to reach out.
      </p>
    </header>

    <div class="grid gap-10">
      
      <form 
        action="https://api.web3forms.com/submit" 
        method="POST" 
        id="contact-form"
        class="space-y-5 bg-white p-6 sm:p-8 rounded-xl border border-slate-200/80 shadow-xs relative"
      >
        
        {/* Web3Forms Access Key */}
        <input type="hidden" name="access_key" value="fad1e043-e8cf-4372-96d8-9f87d820182e" />

        {/* Honeypot Spam Protection */}
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        {/* Name */}
        <div>
          <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Name</label>
          <input 
            type="text" 
            name="name" 
            id="name" 
            required 
            maxlength="100"
            placeholder="Your Name"
            class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all"
          />
        </div>

        {/* Email */}
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Email</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            maxlength="150"
            placeholder="you@example.com"
            class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all"
          />
        </div>

        {/* Message */}
        <div>
          <label for="message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Message</label>
          <textarea 
            name="message" 
            id="message" 
            rows="4" 
            required 
            maxlength="2000"
            placeholder="How can I help you?"
            class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all resize-none"
          ></textarea>
        </div>

        {/* Web3Forms hCaptcha Widget */}
        <div class="h-captcha" data-sitekey="609cce86-507c-4a96-b4a0-e42e6134fbc4"></div>
        <input type="hidden" name="h-captcha-response" id="h-captcha-response" />

        {/* Status Message */}
        <div id="form-result" class="text-xs font-medium hidden"></div>

        {/* Submit Button */}
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full sm:w-auto px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-lg shadow-xs transition-colors cursor-pointer"
        >
          Send Message
        </button>
      </form>

      {/* Direct Contact & Social Links */}
      <div class="space-y-4 pt-4 border-t border-slate-200/80">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Direct Reach & Socials
        </h2>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-sm">
          <div>
            <span class="text-slate-500">Email: </span>
            <a href="mailto:aungthuhtet@payzillion.com" class="font-medium text-slate-900 hover:text-amber-600 transition-colors">
              aungthuhtet@payzillion.com
            </a>
          </div>

          <div class="flex items-center gap-4 text-slate-600">
            <a href="https://www.linkedin.com/company/payzillion" target="_blank" rel="noopener noreferrer" class="hover:text-blue-700 font-medium">LinkedIn</a>
            <a href="https://t.me/PayZillion" target="_blank" rel="noopener noreferrer" class="hover:text-sky-500 font-medium">Telegram</a>
            <a href="https://www.facebook.com/PayZillion" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 font-medium">Facebook</a>
            <a href="https://www.youtube.com/@PayZillion" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 font-medium">YouTube</a>
          </div>
        </div>
      </div>

    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (result) {
      result.classList.remove('hidden', 'text-red-600', 'text-green-600');
      result.classList.add('text-slate-500');
      result.textContent = 'Sending message...';
    }
    submitBtn.disabled = true;

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const json = await response.json();

      if (response.status === 200 && json.success) {
        if (result) {
          result.classList.remove('text-slate-500', 'text-red-600');
          result.classList.add('text-green-600');
          result.textContent = 'Message sent successfully!';
        }
        form.reset();
        if (typeof (window as any).hcaptcha !== 'undefined') {
          (window as any).hcaptcha.reset();
        }
      } else {
        if (result) {
          result.classList.remove('text-slate-500', 'text-green-600');
          result.classList.add('text-red-600');
          result.textContent = json.message || 'Something went wrong. Please try again.';
        }
      }
    } catch (error) {
      if (result) {
        result.classList.remove('text-slate-500', 'text-green-600');
        result.classList.add('text-red-600');
        result.textContent = 'Submission failed. Please try again later.';
      }
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
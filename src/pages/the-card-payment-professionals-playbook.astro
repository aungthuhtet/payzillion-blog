---
// src/pages/the-card-payment-professionals-playbook.astro
import Layout from '../layouts/Layout.astro'; // သင့်ရဲ့ Layout ဖိုင် Path အမှန်ကို ထည့်ပါ
---

<Layout title="The Card Payment Professional’s Playbook (eBook)">
  <main class="max-w-4xl mx-auto py-12 px-4">
    
    <!-- Book Title and Description -->
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
        The Card Payment Professional’s Playbook (eBook)
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        အောက်ပါ Form မှတစ်ဆင့် ငွေလွှဲအချက်အလက်များကို ကြည့်ရှု၍ ငွေလွှဲစလစ် (Receipt) တင်ပြီး ဝယ်ယူနိုင်ပါသည်။
      </p>
    </div>

    <!-- Tally Checkout Form Embed Box -->
    <div class="bg-white shadow-xl rounded-2xl p-4 md:p-8 border border-gray-100">
      <iframe 
        data-tally-src="https://tally.so/embed/zEj7ba?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1" 
        loading="lazy" 
        width="100%" 
        height="1698" 
        frameborder="0" 
        marginheight="0" 
        marginwidth="0" 
        title="The Card Payment Professional’s Playbook (eBook)">
      </iframe>
      
      <!-- Tally Widget Script (is:inline is using for Astro) -->
      <script is:inline>
        var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
      </script>
    </div>

  </main>
</Layout>
---
// src/pages/blog.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Draft မဟုတ်သော Blog Post များကို ယူပြီး ရက်စွဲအလိုက် စီပေးခြင်း
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="Articles and technical insights on payment systems and software engineering.">
  <div class="space-y-8">
    
    <header class="space-y-2 border-b border-slate-200/80 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Articles & Insights
      </h1>
      <p class="text-slate-600 text-base">
        Decoding payment infrastructure, financial engineering, and digital products.
      </p>
    </header>

    {/* Post List */}
    <div class="grid gap-8">
      {posts.map((post) => (
        <article class="p-6 bg-white rounded-xl border border-slate-200/80 hover:border-amber-500/50 transition-all shadow-xs group">
          <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <span>•</span>
            <span class="font-medium text-slate-700">{post.data.author}</span>
          </div>

          <h2 class="text-xl font-bold text-slate-900 group-hover:text-amber-600 transition-colors mb-2">
            <a href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
          </h2>

          <p class="text-slate-600 text-sm leading-relaxed mb-4 line-clamp-2">
            {post.data.description}
          </p>

          <div class="flex items-center gap-2 flex-wrap">
            {post.data.tags.map((tag) => (
              <span class="px-2.5 py-0.5 text-xs font-medium text-slate-600 bg-slate-100 rounded-md border border-slate-200/60">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>
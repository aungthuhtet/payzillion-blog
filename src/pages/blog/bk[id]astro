---
// src/pages/blog/[id].astro
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { 
      post, 
      prevPost: posts[index + 1] || null, // Older post
      nextPost: posts[index - 1] || null  // Newer post
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <article class="max-w-3xl mx-auto space-y-8 py-6 px-4 sm:px-0">
    
    {/* Back to Blog Button */}
    <div>
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-amber-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Articles
      </a>
    </div>

    <header class="space-y-4 border-b border-slate-200/80 pb-6">
      <div class="flex items-center gap-3 text-xs text-slate-500">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span class="font-medium text-slate-700">{post.data.author}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
        {post.data.title}
      </h1>

      <p class="text-lg text-slate-600 leading-relaxed">
        {post.data.description}
      </p>

      <div class="flex items-center gap-2 pt-2 flex-wrap">
        {post.data.tags.map((tag) => (
          <span class="px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 rounded-md border border-amber-200">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    {/* Markdown Content with Proper Paragraph Spacing */}
    <div class="prose prose-slate max-w-none prose-headings:font-bold prose-p:text-slate-700 prose-p:leading-relaxed prose-p:mb-6 prose-a:text-amber-600 hover:prose-a:underline prose-img:rounded-xl">
      <Content />
    </div>

    {/* Previous / Next Post Navigation */}
    <nav class="border-t border-slate-200/80 pt-6 mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a href={`/blog/${prevPost.id}`} class="p-4 rounded-xl border border-slate-200/80 hover:border-amber-500/50 transition-all group bg-white shadow-2xs">
          <span class="text-xs text-slate-500 block mb-1">← Older Article</span>
          <span class="text-sm font-bold text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-1">
            {prevPost.data.title}
          </span>
        </a>
      ) : <div />}

      {nextPost ? (
        <a href={`/blog/${nextPost.id}`} class="p-4 rounded-xl border border-slate-200/80 hover:border-amber-500/50 transition-all group bg-white shadow-2xs text-right sm:col-start-2">
          <span class="text-xs text-slate-500 block mb-1">Newer Article →</span>
          <span class="text-sm font-bold text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-1">
            {nextPost.data.title}
          </span>
        </a>
      ) : <div />}
    </nav>

  </article>
</Layout>
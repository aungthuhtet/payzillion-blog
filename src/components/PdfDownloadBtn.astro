---
// src/components/PdfDownloadBtn.astro
interface Props {
  href: string;
  title?: string;
  fileSize?: string;
}

const { href, title = "Download PDF Document", fileSize } = Astro.props;
---

<div class="not-prose my-6">
  <a 
    href={href} 
    download 
    class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-2xl hover:border-amber-500 dark:hover:border-amber-500 transition group shadow-2xs"
  >
    <div class="flex items-center gap-3">
      {/* PDF Icon */}
      <div class="p-3 bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-xl group-hover:scale-105 transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 group-hover:text-amber-600 transition">{title}</h4>
        {fileSize && <p class="text-xs text-slate-500 dark:text-slate-400">PDF Document • {fileSize}</p>}
      </div>
    </div>

    {/* Download Arrow Icon */}
    <div class="flex items-center gap-2 px-4 py-2 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium rounded-xl group-hover:bg-amber-600 dark:group-hover:bg-amber-500 transition">
      <span>Download</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
    </div>
  </a>
</div>
---
// src/components/InstantEbookDownload.astro
interface Props {
  formId: string;       // Kit Form ID
  pdfUrl: string;       // PDF File Path from public folder (e.g: /downloads/ebook.pdf)
  bookTitle?: string;
}

const { formId, pdfUrl, bookTitle = "Free E-Book" } = Astro.props;
---

<div class="not-prose my-8 p-6 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-sm max-w-xl mx-auto">
  <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2">📥 Download {bookTitle} for Free</h3>
  <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">Enter your email below to instantly download the PDF guide.</p>
  
  <form id="ebook-form" class="space-y-3" data-form-id={formId} data-pdf-url={pdfUrl}>
    <div>
      <input 
        type="email" 
        id="subscriber-email" 
        required 
        placeholder="Enter your email address..." 
        class="w-full px-4 py-2.5 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-900 dark:text-slate-100"
      />
    </div>

    <button 
      type="submit"
      id="download-submit-btn"
      class="w-full py-2.5 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-sm font-medium rounded-xl hover:bg-amber-600 dark:hover:bg-amber-500 transition cursor-pointer"
    >
      Get Instant Download
    </button>
  </form>

  <div id="download-message" class="mt-3 text-sm hidden font-medium text-center"></div>
</div>

<script>
  const form = document.getElementById('ebook-form') as HTMLFormElement;
  const emailInput = document.getElementById('subscriber-email') as HTMLInputElement;
  const submitBtn = document.getElementById('download-submit-btn') as HTMLButtonElement;
  const messageDiv = document.getElementById('download-message');

  if (form) {
    const formId = form.getAttribute('data-form-id');
    const pdfUrl = form.getAttribute('data-pdf-url');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email) return;

      // Loading state
      submitBtn.disabled = true;
      submitBtn.textContent = 'Processing...';

      try {
        // Sending Email to Kit API (ConvertKit Public API v3)
        const response = await fetch(`https://api.convertkit.com/v3/forms/${10124032}/subscribe`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            api_key: 'jT6jeCTLc7fL7Ilp8BXTuQ', // Public API Key from Kit Dashboard
            email: email
          })
        });

        if (response.ok || response.status === 200) {
          // PDF will Download instantly upon successful email submission
          if (messageDiv) {
            messageDiv.classList.remove('hidden', 'text-red-600');
            messageDiv.classList.add('text-emerald-600');
            messageDiv.textContent = '🎉 Success! Your download is starting automatically...';
          }

          // Trigger automated file download
          const link = document.createElement('a');
          link.href = pdfUrl || '#';
          link.download = '';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          form.reset();
        } else {
          throw new Error('Something went wrong.');
        }
      } catch (error) {
        // Even API connectivity have issue, not to dispappoint the user PDF will instantly download and save the email as backup
        if (messageDiv) {
          messageDiv.classList.remove('hidden', 'text-red-600');
          messageDiv.classList.add('text-emerald-600');
          messageDiv.textContent = '🎉 Thank you! Your download has started.';
        }
        const link = document.createElement('a');
        link.href = pdfUrl || '#';
        link.download = '';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get Instant Download';
      }
    });
  }
</script>
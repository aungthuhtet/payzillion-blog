---
// src/components/Newsletter.astro
---

<section data-pagefind-ignore class="bg-white border border-slate-200/80 rounded-2xl p-8 sm:p-10 my-12 shadow-xs">
  <div class="max-w-xl mx-auto text-center space-y-3">
    <h3 class="text-2xl font-bold tracking-tight text-slate-900">
      Stay Updated with PayZillion
    </h3>
    <p class="text-slate-600 text-sm leading-relaxed">
      Get the latest articles on payment systems, architecture, and infrastructure delivered straight to your inbox.
    </p>

    {/* Kit Form Submission */}
    <form 
      action="https://app.kit.com/forms/10083864/subscriptions" 
      method="post" 
      class="flex flex-col sm:flex-row gap-3 pt-3"
    >
      <input 
        type="email" 
        name="email_address" 
        placeholder="Enter your email address..." 
        required 
        class="flex-1 px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition text-sm"
      />
      <button 
        type="submit" 
        class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-medium rounded-xl transition text-sm cursor-pointer shrink-0 shadow-xs"
      >
        Subscribe
      </button>
    </form>
    
    <p class="text-xs text-slate-400 pt-1">
      No spam, zero clutter. Unsubscribe at any time.
    </p>
  </div>
</section>
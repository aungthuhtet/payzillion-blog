---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {  
  title,  
  description = "Decoding the Payments Ecosystem, Architecture & Infrastructure.",
  image = "/og-image.jpg",
  type = "website"
} = Astro.props;

const currentYear = new Date().getFullYear();
const pageTitle = `${title} | PayZillion`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    {/* Primary Meta Tags */}
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Aung Thu Htet" />

    {/* Open Graph / Facebook / LinkedIn / Telegram */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="PayZillion" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {/* Theme Branding Color */}
    <meta name="theme-color" content="#00386A" />

    {/* Pagefind UI CSS */}
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

    {/* AI SEO / Structured Data (Schema.org for Tech Blog) */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "PayZillion",
        "url": "https://payzillion.com",
        "description": "Decoding the Payments Ecosystem, Architecture & Infrastructure.",
        "author": {
          "@type": "Person",
          "name": "Aung Thu Htet"
        }
      }
    </script>
  </head>
  <body class="bg-slate-50/50 text-slate-900 font-sans antialiased selection:bg-amber-500 selection:text-white flex flex-col min-h-screen">

    {/* Header (data-pagefind-ignore ထည့်ထားပါသည်) */}
    <header data-pagefind-ignore class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
        
        <a href="/" class="flex items-center gap-2.5 group hover:opacity-90 transition-opacity shrink-0">
          <img src="/logo.png" alt="PayZillion Logo" class="w-8 h-8 object-contain" />
          <span class="font-bold text-lg tracking-tight">
            <span style="color: #FFAA4D;">Pay</span><span style="color: #00386A;">Zillion</span>
          </span>
        </a>

        {/* Right side: Nav links + Search Icon Button */}
        <div class="flex items-center gap-5">
          <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-slate-700 shrink-0">
            <a href="/" class="hover:text-amber-600 transition-colors">Home</a>

            {/* Books Dropdown Menu */}
            <div class="relative group py-2">
              <button class="flex items-center gap-1 hover:text-amber-600 transition focus:outline-none cursor-pointer">
                Books
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <div class="absolute left-0 top-full hidden group-hover:block w-72 bg-white border border-slate-200 rounded-xl shadow-lg py-2 z-50">
                <a href="/the-card-payment-professionals-playbook" class="block px-4 py-2 text-xs text-slate-700 hover:bg-amber-50 hover:text-amber-600 transition">
                  The Card Payments Professional's Playbook
                </a>
                <a href="/payments-made-simple-book" class="block px-4 py-2 text-xs text-slate-700 hover:bg-amber-50 hover:text-amber-600 transition">
                  Payments Made Simple (Free Download)
                </a>
                <a href="/payment-essentials" class="block px-4 py-2 text-xs text-slate-700 hover:bg-amber-50 hover:text-amber-600 transition">
                  Payment Essentials (Free Download)
                </a>
              </div>
            </div>

            {/* Tools Dropdown Menu */}
            <div class="relative group py-2">
              <button class="flex items-center gap-1 hover:text-amber-600 transition focus:outline-none cursor-pointer">
                Tools
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <div class="absolute left-0 top-full hidden group-hover:block w-60 bg-white border border-slate-200 rounded-xl shadow-lg py-2 z-50">
                <a href="https://simulator.payzillion.com/" target="_blank" rel="noopener noreferrer" class="block px-4 py-2 text-xs text-slate-700 hover:bg-amber-50 hover:text-amber-600 transition">
                  Card Payments Simulator ↗
                </a>
                <a href="/card-number-checker-luhn-algorithm" class="block px-4 py-2 text-xs text-slate-700 hover:bg-amber-50 hover:text-amber-600 transition">
                  Card Number Validator
                </a>
              </div>
            </div>

            <a href="/about" class="hover:text-amber-600 transition-colors">About</a>
            <a href="/contact" class="hover:text-amber-600 transition-colors">Contact</a>
          </nav>

          {/* Search Trigger Button */}
          <button 
            id="search-open-btn"
            type="button" 
            aria-label="Search"
            class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-full transition cursor-pointer"
          >
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span class="hidden sm:inline">Search...</span>
          </button>

          <button id="menu-btn" aria-label="Toggle Menu" class="md:hidden p-2 rounded-md text-slate-600 hover:bg-slate-100 cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      {/* Mobile Menu */}
      <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-6 py-4 space-y-3">
        <a href="/" class="block text-slate-700 hover:text-amber-600 font-medium">Home</a>
        
        <div class="font-medium text-slate-700 pt-1">Books:</div>
        <div class="pl-4 space-y-2 border-l-2 border-slate-100">
          <a href="/the-card-payment-professionals-playbook-announcement" class="block text-xs text-slate-600 hover:text-amber-600">The Card Payments Professional's Playbook</a>
          <a href="/payments-made-simple-book" class="block text-xs text-slate-600 hover:text-amber-600">Payments Made Simple (Free Download)</a>
          <a href="/payment-essentials" class="block text-xs text-slate-600 hover:text-amber-600">Payment Essentials (Free Download)</a>
        </div>

        <div class="font-medium text-slate-700 pt-1">Tools:</div>
        <div class="pl-4 space-y-2 border-l-2 border-slate-100">
          <a href="https://simulator.payzillion.com/" target="_blank" rel="noopener noreferrer" class="block text-xs text-slate-600 hover:text-amber-600">Card Payments Simulator ↗</a>
          <a href="/card-number-checker-luhn-algorithm" class="block text-xs text-slate-600 hover:text-amber-600">Card Number Validator</a>
        </div>

        <a href="/about" class="block text-slate-700 hover:text-amber-600 font-medium pt-1">About</a>
        <a href="/contact" class="block text-slate-700 hover:text-amber-600 font-medium">Contact</a>
      </div>
    </header>

    {/* Main Content */}
    <main class="flex-grow max-w-4xl mx-auto px-6 py-10 w-full">
      <slot />
    </main>

    {/* Search Modal Popup */}
    <div id="search-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl border border-slate-200 p-6 relative max-h-[85vh] overflow-y-auto flex flex-col">
        <div class="flex items-center justify-between pb-4 mb-2 border-b border-slate-100 sticky top-0 bg-white z-10">
          <h2 class="text-lg font-semibold text-slate-800">ဆောင်းပါးများ ရှာဖွေရန်</h2>
          <button id="search-close-btn" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-2 cursor-pointer" aria-label="Close search">
            ✕
          </button>
        </div>
        <div id="search-container" class="flex-1"></div>
      </div>
    </div>

    {/* Footer */}
    <footer data-pagefind-ignore class="border-t border-slate-200/80 bg-white py-10 text-slate-500 mt-auto">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-6">
        <p class="text-xs">&copy; {currentYear} PayZillion. All rights reserved.</p>

        <div class="flex items-center gap-5 text-slate-500">
          <a href="https://www.facebook.com/PayZillion" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://t.me/PayZillion" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="hover:text-sky-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/payzillion" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-blue-700 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
          </a>
          <a href="https://www.youtube.com/@PayZillion" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="hover:text-red-600 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </footer>
      
    {/* Pagefind JS & Modal Interactivity */}
    <script src="/pagefind/pagefind-ui.js" type="text/javascript" defer></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        // PagefindUI ကို Safe ဖြစ်စေရန် စစ်ဆေးခြင်း
        if (typeof PagefindUI !== 'undefined') {
          new PagefindUI({ 
            element: "#search-container", 
            showSubResults: true,
            resetStyles: false
          });
        }

        const modal = document.getElementById('search-modal');
        const openBtn = document.getElementById('search-open-btn');
        const closeBtn = document.getElementById('search-close-btn');

        const openModal = () => {
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
          setTimeout(() => {
            modal?.querySelector('input')?.focus();
          }, 100);
        };

        const closeModal = () => {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        };

        openBtn?.addEventListener('click', openModal);
        closeBtn?.addEventListener('click', closeModal);

        modal?.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      });
    </script>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>